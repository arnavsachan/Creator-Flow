# Application Settings
APP_NAME="Innotech API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database Configuration
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
# NOTE: If your password contains special characters (e.g. @, :, /, #, %),
# they MUST be URL-encoded (e.g. '@' becomes '%40').
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/<DB_NAME>

# CORS Configuration
# Comma-separated list of allowed origins. Whitespace and trailing slashes are stripped.
# In production, wildcard '*' and empty lists are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI must match: http://localhost:8000/api/v1/youtube/oauth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback

# Security & Encryption Settings
# TOKEN_ENCRYPTION_KEY: Secret key used to encrypt OAuth refresh/access tokens at rest.
# Must be a 32-byte urlsafe base64 string or long passphrase.
TOKEN_ENCRYPTION_KEY=replace-with-a-secure-32-byte-base64-encryption-key

# JWT Application Authentication
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Shorts Clipper Configuration
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SHORTS_STORAGE_DIR=
SHORTS_MAX_UPLOAD_MB=500
SHORTS_MAX_DURATION_SECONDS=3600
SHORTS_MAX_CLIP_SECONDS=180
SHORTS_ENABLED_ENVIRONMENTS=development,test

# Whisper Speech Transcription (Stage 3a)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_THREADS=4
# Empty = auto-detect language (do not force 'en' as it translates Hindi speech)
WHISPER_LANGUAGE=
# Guide model to Roman Hinglish output. Set to 'off' to disable.
WHISPER_INITIAL_PROMPT=Yeh ek Hinglish video hai, jisme Hindi aur English dono mix hain. Bhai, aaj hum ek important topic ke baare me baat karenge.
TRANSCRIBE_MAX_SECONDS=600
WHISPER_MODEL_DIR=

# AI Highlight Suggestions (Stage 3b)
# Provider (only 'gemini' is supported)
AI_PROVIDER=gemini
# Google Gemini API key (empty by default; if empty, returns 503 AI_NOT_CONFIGURED)
GEMINI_API_KEY=
# Gemini model name (e.g. gemini-2.5-flash; empty by default, no hardcoded default)
AI_MODEL=
# Request timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS=60
# Highlight minimum clip duration in seconds
HIGHLIGHT_MIN_SECONDS=15
# Highlight maximum clip duration in seconds (must be <= 180s)
HIGHLIGHT_MAX_SECONDS=60
# Maximum highlight suggestions to request
HIGHLIGHT_MAX_SUGGESTIONS=5
